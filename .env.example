# Copy to .env to override anything:   cp .env.example .env
# docker-compose.yml already falls back to the values below, so .env is optional for a first run.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL (used by the postgres service AND to build the API's connection string) -----------
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Postgres applies these only when it first creates its data volume. Changing them later makes the API
# fail to log in until you reset the volume:  docker compose down -v
# Avoid ';' and '$' in the password: it is embedded in the Npgsql connection string by docker-compose.yml.

# --- API: values passed straight through to the container -----------------------------------------
# How long a seat hold lasts before it auto-releases, in seconds. Must be > 0.
HOLD_DURATION_SECONDS=600
# Background job that tidies expired holds. Holds expire correctly even if this is off.
HOLD_EXPIRY_SWEEP_ENABLED=true
HOLD_EXPIRY_SWEEP_INTERVAL_SECONDS=5

# --- API: database connections per instance ---------------------------------------------------------
# The most PostgreSQL connections ONE API instance may hold (Npgsql "Maximum Pool Size"). Postgres allows 100 in
# total, 3 of them kept for superusers, so instances x this value must stay at or below 97: 30 fits three instances.
# Without a cap Npgsql would let one busy instance keep up to 100 idle connections and starve the others.
# More instances than that: lower this, or raise max_connections on the postgres service.
DB_MAX_POOL_SIZE=30

# --- API: which browser pages may call it (CORS) ---------------------------------------------------
# Comma-separated origins, each the scheme + host + port of the page that makes the calls, e.g.
# http://localhost:5173. Exact matches only: no wildcard, no path. A bad value stops the API at startup.
# The default is the frontend's two local servers (npm run dev = 5173, npm run preview = 4173) and the
# frontend container (http://localhost:3000). If you change FRONTEND_PORT below, the compose default
# follows it; if you set this variable yourself, list the new origin here too.
# Leave the value EMPTY to switch CORS off (for example when the API and the frontend are served from one
# origin); deleting the line restores the default.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- Host port the API is published on (container always listens on 8080) --------------------------
API_PORT=8080

# --- Frontend container ------------------------------------------------------------------------------
# Host port the web app is published on (the container always listens on 80).
FRONTEND_PORT=3000
# Where the BROWSER finds the API, written into /config.js when the frontend container starts. It must be
# reachable from the browser: http://localhost:<API_PORT> on the same machine, never http://backend:8080.
# Leave it out to follow API_PORT automatically.
# API_BASE_URL=http://localhost:8080

# Set by docker-compose.yml, not here (listed so the full set is in one place):
#   ConnectionStrings__Postgres = Host=postgres;Port=5432;Database=$POSTGRES_DB;Username=$POSTGRES_USER;Password=$POSTGRES_PASSWORD;Maximum Pool Size=$DB_MAX_POOL_SIZE
#   ASPNETCORE_ENVIRONMENT      = Production
#   ASPNETCORE_HTTP_PORTS       = 8080   (set in the Dockerfile)
