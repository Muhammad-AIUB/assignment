# Copy to .env to override anything:   cp .env.example .env
# docker-compose.yml already falls back to the values below, so .env is optional for a first run.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL (used by the postgres service AND to build the API's connection string) -----------
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Postgres applies these only when it first creates its data volume. Changing them later makes the API
# fail to log in until you reset the volume:  docker compose down -v
# Avoid ';' and '$' in the password: it is embedded in the Npgsql connection string by docker-compose.yml.

# --- API: values passed straight through to the container -----------------------------------------
# How long a seat hold lasts before it auto-releases, in seconds. Must be > 0.
HOLD_DURATION_SECONDS=600
# Background job that tidies expired holds. Holds expire correctly even if this is off.
HOLD_EXPIRY_SWEEP_ENABLED=true
HOLD_EXPIRY_SWEEP_INTERVAL_SECONDS=5

# --- Host port the API is published on (container always listens on 8080) --------------------------
API_PORT=8080

# Set by docker-compose.yml, not here (listed so the full set is in one place):
#   ConnectionStrings__Postgres = Host=postgres;Port=5432;Database=$POSTGRES_DB;Username=$POSTGRES_USER;Password=$POSTGRES_PASSWORD
#   ASPNETCORE_ENVIRONMENT      = Production
#   ASPNETCORE_HTTP_PORTS       = 8080   (set in the Dockerfile)
